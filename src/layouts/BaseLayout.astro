---
import "../assets/app.css";
import { withBase } from "../lib/base";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
};

const SITE_NAME = "smellman's Portfolio";
const {
  title,
  description = "地図・OpenStreetMap・OSS・UNIX が好きなソフトウェアエンジニアのポートフォリオ。",
  image = "/favicon.svg",
  ogType = "website",
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

const siteUrl = Astro.site ?? new URL("https://portofolio.smellman.org/");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const absImage = /^https?:\/\//.test(image)
  ? image
  : new URL(withBase(image), siteUrl).toString();

const nav = {
  home: withBase("/"),
  profile: withBase("/profile"),
  works: [
    { label: "Geolonia", href: withBase("/works/geolonia") },
    { label: "Georepublic", href: withBase("/works/georepublic") },
    { label: "OSS Contributions", href: withBase("/works/contributions") },
  ],
  hobby: [
    { label: "Music", href: withBase("/hobby/music") },
    { label: "Games", href: withBase("/hobby/games") },
  ],
  programmings: withBase("/programmings"),
  presentations: withBase("/presentations"),
};

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-1E8Y2VTYHW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1E8Y2VTYHW');
    </script>

    <!-- テーマ(light/dark)を描画前に適用してチラつきを防ぐ。
         保存済みの選択がなければ OS の設定に従う。 -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.svg")} sizes="any" />
    <link rel="apple-touch-icon" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
  </head>

  <body class="min-h-screen flex flex-col bg-base-200 text-base-content">
    <header class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-30 px-4">
      <div class="navbar-start">
        <div class="dropdown lg:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-square">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </div>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-40 p-2 shadow bg-base-100 rounded-box w-56">
            <li><a href={nav.home}>Home</a></li>
            <li><a href={nav.profile}>Profile</a></li>
            <li>
              <details>
                <summary>Works</summary>
                <ul>
                  {nav.works.map((w) => <li><a href={w.href}>{w.label}</a></li>)}
                </ul>
              </details>
            </li>
            <li>
              <details>
                <summary>Hobby</summary>
                <ul>
                  {nav.hobby.map((h) => <li><a href={h.href}>{h.label}</a></li>)}
                </ul>
              </details>
            </li>
            <li><a href={nav.programmings}>Programming</a></li>
            <li><a href={nav.presentations}>Presentations</a></li>
          </ul>
        </div>
        <a href={nav.home} class="btn btn-ghost text-lg font-bold normal-case">{SITE_NAME}</a>
      </div>

      <nav class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 gap-1">
          <li><a href={nav.home}>Home</a></li>
          <li><a href={nav.profile}>Profile</a></li>
          <li>
            <details>
              <summary>Works</summary>
              <ul class="p-2 z-40 bg-base-100 rounded-box w-48">
                {nav.works.map((w) => <li><a href={w.href}>{w.label}</a></li>)}
              </ul>
            </details>
          </li>
          <li>
            <details>
              <summary>Hobby</summary>
              <ul class="p-2 z-40 bg-base-100 rounded-box w-48">
                {nav.hobby.map((h) => <li><a href={h.href}>{h.label}</a></li>)}
              </ul>
            </details>
          </li>
          <li><a href={nav.programmings}>Programming</a></li>
          <li><a href={nav.presentations}>Presentations</a></li>
        </ul>
      </nav>

      <div class="navbar-end">
        <label class="swap swap-rotate btn btn-ghost btn-square" title="ライト / ダークテーマ切り替え">
          <!-- daisyUI の theme-controller。checked = dark -->
          <input id="theme-toggle" type="checkbox" class="theme-controller" value="dark" />
          <span class="sr-only">テーマ切り替え</span>
          <svg class="swap-off w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M5.64 17l-.71.71a1 1 0 0 0 1.41 1.41l.71-.71A1 1 0 0 0 5.64 17ZM5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm7-7a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1ZM5.64 7.05a1 1 0 0 0 .7.29 1 1 0 0 0 .71-.29 1 1 0 0 0 0-1.41l-.71-.71a1 1 0 0 0-1.41 1.41Zm12 .29a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-9 8a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Zm6.36-2A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Z"
            ></path>
          </svg>
          <svg class="swap-on w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Z"
            ></path>
          </svg>
        </label>

        <a
          href="https://github.com/smellman"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost btn-square"
          title="GitHub"
        >
          <svg viewBox="0 0 16 16" class="w-5 h-5" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </div>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="footer footer-center bg-base-100 border-t border-base-300 p-6 text-base-content/70">
      <aside>
        <p>© {year} smellman (Taro Matsuzawa)</p>
      </aside>
    </footer>

    <script is:inline>
      (function () {
        var input = document.getElementById("theme-toggle");
        if (!input) return;

        // head で適用済みのテーマにトグルの状態を合わせる
        input.checked = document.documentElement.getAttribute("data-theme") === "dark";

        input.addEventListener("change", function () {
          var t = input.checked ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", t);
          try { localStorage.setItem("theme", t); } catch (e) {}
        });

        // 明示的に選んでいない間は OS の設定変更に追従する
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (e) {
          var saved = null;
          try { saved = localStorage.getItem("theme"); } catch (err) {}
          if (saved === "light" || saved === "dark") return;
          var t = e.matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", t);
          input.checked = e.matches;
        });
      })();
    </script>
  </body>
</html>
