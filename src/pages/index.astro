---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";

const cards = [
  {
    title: "Profile",
    desc: "略歴・ハンドルネーム・執筆歴など。",
    links: [{ label: "Profile", href: withBase("/profile") }],
  },
  {
    title: "Works",
    desc: "所属・お仕事、OSSコントリビューションなど。",
    links: [
      { label: "Geolonia", href: withBase("/works/geolonia") },
      { label: "Georepublic", href: withBase("/works/georepublic") },
      { label: "OSS Contributions", href: withBase("/works/contributions") }
    ],
  },
  {
    title: "Presentations",
    desc: `各地での登壇資料など。`,
    links: [{ label: "地図で見る", href: withBase("/presentations") }],
  },
  {
    title: "Programming",
    desc: "使ってきた言語・技術について。",
    links: [{ label: "Programming", href: withBase("/programmings") }],
  },
  {
    title: "Hobby",
    desc: "音楽とゲーム。仕事以外の楽しみ。",
    links: [
      { label: "Music", href: withBase("/hobby/music") },
      { label: "Games", href: withBase("/hobby/games") },
    ],
  },
];
---

<BaseLayout>
  <section class="hero bg-base-100 border-b border-base-300">
    <div class="hero-content text-center py-16">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl font-bold">smellman</h1>
        <p class="mt-4 text-lg text-base-content/70">
          Taro Matsuzawa — 地図とUNIXとブレイクコアが好きなソフトウェアエンジニア。
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-12 grid gap-6 sm:grid-cols-2">
    {
      cards.map((c) => (
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <h2 class="card-title">{c.title}</h2>
            <p class="text-base-content/70">{c.desc}</p>
            <div class="card-actions justify-end mt-2">
              {c.links.map((l) => (
                <a href={l.href} class="btn btn-sm btn-ghost">
                  {l.label} →
                </a>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
